# Docker'siz o'rnatish (TZ: R9-3). Nusxa: /etc/systemd/system/guliston-web.service
# Muhit: /etc/guliston/guliston.env (DEBUG=False, DATABASE_URL=..., DJANGO_SECRET_KEY=..., ALLOWED_HOSTS=...)
[Unit]
Description=Guliston restoran menyu — web (gunicorn)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=guliston
Group=guliston
WorkingDirectory=/srv/guliston/backend
EnvironmentFile=/etc/guliston/guliston.env
Environment=DJANGO_SKIP_DOTENV=1
ExecStartPre=/srv/guliston/backend/venv/bin/python manage.py migrate --noinput
ExecStartPre=/srv/guliston/backend/venv/bin/python manage.py collectstatic --noinput
ExecStart=/srv/guliston/backend/venv/bin/gunicorn -c gunicorn.conf.py backend.wsgi:application
Restart=always
RestartSec=3
# Yangi kod chiqqanda: systemctl reload guliston-web (gunicorn ishchilarini ketma-ket almashtiradi)
ExecReload=/bin/kill -s HUP $MAINPID
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
