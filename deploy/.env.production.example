# Production sozlamalari (TZ: R9). `cp .env.production.example .env` va hamma qiymatni to'ldiring.
# HECH QACHON git'ga qo'shilmaydi (.gitignore'da).

# ── Domen ────────────────────────────────────────────────────────────────
# QR kodlar shu domenda chop etiladi: keyin o'zgartirsangiz, chop etilgan QR'lar eskiradi!
DOMAIN=menu.example.uz
# Lokal sinov uchun (80/443 band bo'lsa): HTTP_PORT=8080, HTTPS_PORT=8443
#HTTP_PORT=80
#HTTPS_PORT=443

# ── Baza ─────────────────────────────────────────────────────────────────
POSTGRES_DB=guliston
POSTGRES_USER=guliston
# URL ichida ishlatiladi: faqat harf va raqam bo'lsin (openssl rand -hex 24)
POSTGRES_PASSWORD=
#PG_SHARED_BUFFERS=256MB
#PG_EFFECTIVE_CACHE_SIZE=768MB

# ── Django ───────────────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# ── Telegram (bildirishnomalar) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Xodim/guruh chat ID (ixtiyoriy: restoran sozlamalarida ham beriladi)
TELEGRAM_CHAT_ID=
# Qo'shimcha xabarlar (standart o'chiq): holat o'zgarishi, ofitsiant chaqiruvi, taom tayyor
TELEGRAM_NOTIFY_STATUS_CHANGES=False
TELEGRAM_NOTIFY_SERVICE_CALLS=False
TELEGRAM_NOTIFY_DISH_READY=False

# ── Xavfsizlik / monitoring ──────────────────────────────────────────────
SENTRY_DSN=
# Zaxira va monitoring skriptlari xabar yuboradigan chat (egasining shaxsiy chati)
ALERT_TELEGRAM_CHAT_ID=
# Eski bozor/studiya/ar3d/onlayn-to'lov API'lari restoran mahsulotida YOPIQ (404/405). Faqat aniq zarurat bo'lsa True; ochilsa
# anonim narx o'zgartirish, begona buyurtmaga kirish kabi xavflar qaytadi (TZ_SOTUVGA_TAYYORLASH P0).
#LEGACY_API_ENABLED=False
# /health/ ning to'liq javobi (disk, xotira, outbox) uchun monitoring sarlavhasi `X-Health-Token`; bo'sh bo'lsa to'liq javobni
# faqat rahbariyat sessiyasi ko'radi, anonim so'rovga faqat {"status": ...} qaytadi.
#HEALTH_TOKEN=
# Fayl keshi chegarasi (Redis ulanguncha vaqtincha chora) va bitta buyurtmadagi qatorlar chegarasi
#CACHE_MAX_ENTRIES=5000
#RESTAURANT_MAX_ORDER_LINES=50

# ── Demo / sinov rejimlari (production'da DOIM False) ────────────────────
DEMO_MODE=False
ALLOW_MOCK_PAYMENTS=False
RESTAURANT_ALLOW_TABLE_NUMBER_URL=False

# ── Gunicorn & Poollar (TZ 0.6) ──────────────────────────────────────────
# Mehmon pooli (web):
#WEB_CONCURRENCY=3
#GUNICORN_THREADS=4
# Xodimlar pooli (web-staff: KDS, POS, Resto-Admin):
#STAFF_WEB_CONCURRENCY=2
#STAFF_GUNICORN_THREADS=4

# ── Resto-Admin Subdomen (ixtiyoriy, bo'sh bo'lsa faqat /ra/ ishlatiladi) ──
#RESTO_ADMIN_HOST=resto-admin.example.uz
