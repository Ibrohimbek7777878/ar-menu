# TLS (Let's Encrypt avtomatik), statika, media va web'ga proksi (TZ: R9-4). Domen: DOMAIN muhit o'zgaruvchisi.
# DOMAIN=localhost bo'lsa Caddy o'z ichki sertifikatini beradi (lokal sinov uchun).
{$DOMAIN} {
	encode zstd gzip

	# Fayl nomi hash'li (kontent o'zgarsa nom o'zgaradi) — brauzer abadiy keshlaydi. Ikki xil hash:
	#   1) Vite (8 belgi, base64url): admins `name.HASH.js` (nuqta), frontend `name-HASH.js` (chiziqcha);
	#      faqat `/static/admins|react/.../assets/` ichida (public/ dan ko'chirilgan hash'siz fayllar — models, media,
	#      favicon — va index.html/manifest `immutable` olmasin). Hash o'zi ham `-` va `_` ni saqlashi mumkin (printer.BnhYhF-O.js).
	#   2) Django ManifestStaticFilesStorage (12 hex): `name.<12 hex>.ext` (/static/admin/... ham, collectstatic'dan keyin).
	# Regex Go RE2 uchun (lookahead/backreference yo'q); `deploy/scripts/test_caddy_regex.py` uni haqiqiy fayl nomlari
	# va manfiy misollar bilan, shuningdek haqiqiy Caddy konteynerida sinaydi — regex'ni o'zgartirsangiz shu testni yurgizing.
	# `file` sharti: fayl yo'q bo'lsa (404) `immutable` yopishmaydi — aks holda brauzer 404 ni bir yil keshlab qo'yardi.
	@hashed {
		path_regexp hashed ^/static/(?:(?:admins|react)/(?:.+/)?assets/[^/]+[.-][A-Za-z0-9_-]{8}|.+\.[0-9a-f]{12})\.(?:js|mjs|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$
		file {
			root /srv
			try_files {path}
		}
	}
	handle @hashed {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /static/* {
		root * /srv
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# Yuklangan rasm/3D modellar. Brauzer 1 kun keshlaydi; fayl nomi o'zgarmaydi (qayta yuklansa yangi nom beriladi)
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=86400"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	# Xodimlar va ma'muriyat magistrali (TZ 0.6: KDS, POS ofitsiant, Resto-Admin SPA, moliya) -> web-staff
	@staff path /api/restaurant/admin/* /api/kds/* /api/v1/restaurant/orders* /api/v1/restaurant/tables* /api/v1/restaurant/calls* /api/v1/restaurant/finance* /seller/* /admin/* /kds* /kitchen* /waiter* /arrival* /ra/* /ra
	handle @staff {
		reverse_proxy web-staff:8000
	}

	# Mehmonlar va umumiy oqim (3D menyu, savat, stol, welcome) -> web
	handle {
		# Sog'lomlikni Docker (web konteyner health-check) va tashqi healthcheck.sh kuzatadi; Caddy'ning faol tekshiruvi
		# kerak emas (u Host sarlavhasisiz /health/ ga urilib, Django'dan 400/301 olib, web'ni "nosoz" deb belgilardi)
		reverse_proxy web:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format console
	}
}
