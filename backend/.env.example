# ─── Core ───────────────────────────────────────────────────────────────
# DIQQAT: DEBUG=True faqat lokal ishlash uchun. Internetga ochiladigan serverda DOIM False.
DEBUG=True
# Kalit nomi aynan DJANGO_SECRET_KEY (avval bu yerda SECRET_KEY yozilgan edi, kod esa uni o'qimasdi va
# kodda ochiq turgan kalitdan jimgina foydalanardi). Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.uz
# Production: https://yourdomain.uz (vergul bilan ajratiladi)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=https://yourdomain.uz
# Server ochiq manzili (QR, Telegram havolalari shundan yasaladi)
PUBLIC_DOMAIN=127.0.0.1:8000
SITE_URL=
DJANGO_SETTINGS_MODULE=backend.settings

# ─── Database (PostgreSQL) — leave POSTGRES_DB empty to use SQLite ────────
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Redis / Celery ──────────────────────────────────────────────────────
# Leave REDIS_URL empty to run tasks eagerly (inline) without a broker.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─── Telegram Bot ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=

# ─── Payments ───────────────────────────────────────────────────────────
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_API_URL=https://api.click.uz/v1

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_API_URL=https://payme.uz/api/

UZCARD_MERCHANT_ID=
UZCARD_SECRET_KEY=
UZCARD_API_URL=https://api.paycom.uz/v2
UZCARD_CALLBACK_URL=

# ─── AI (OpenAI) ────────────────────────────────────────────────────────
AI_API_KEY=
AI_PROVIDER=openai
AI_TEXT_MODEL_FAST=gpt-4o-mini
AI_TEXT_MODEL_QUALITY=gpt-4o

# ─── Storage (S3-compatible) ────────────────────────────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ─── Monitoring ─────────────────────────────────────────────────────────
SENTRY_DSN=
TELEGRAM_ADMIN_CHAT_IDS=  # admin chat id lar (vergul bilan, ixtiyoriy)

# ─── V12: MCP — 8 ta AI provayder kalitlari (kalit qo'yilgach tizim o'zi aniqlaydi) ───
# python manage.py mcp_check   → hammasini bir daqiqada tekshiradi
# python manage.py mcp_status  → jadval: kalit/circuit/xarajat
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
MESHY_API_KEY=
TRIPO_API_KEY=
MCP_DAILY_BUDGET=5

# ─── Restoran Bosqich 0 (xavfsizlik) ─────────────────────────────────
# Demo rejim: mock to'lov, demo bron/taomlar. Production'da DOIM False.
DEMO_MODE=False
# Faqat mock to'lov sahifalarini yoqish (DEMO_MODE'siz). Production'da False.
ALLOW_MOCK_PAYMENTS=False
# Restoran xizmat haqi foizi (TZ qarori: olinmaydi → 0)
RESTAURANT_SERVICE_FEE_PERCENT=0
# Telegram webhook secret (ixtiyoriy). Bo'sh bo'lsa bot tokeni + SECRET_KEY dan avtomatik hosil qilinadi.
# O'zgartirilgandan keyin: python manage.py set_telegram_webhook <https://domen>
TELEGRAM_WEBHOOK_SECRET=
# Bot API manzili (bo'sh = rasmiy api.telegram.org). Faqat lokal Bot API serveri yoki sinov uchun.
TELEGRAM_API_BASE=
# Xodim chatiga qo'shimcha xabarlar (admin paneldagi AppSetting: telegram_notify_status_changes / _service_calls /
# _dish_ready ustun turadi). Standart: o'chiq.
TELEGRAM_NOTIFY_STATUS_CHANGES=False
TELEGRAM_NOTIFY_SERVICE_CALLS=False
TELEGRAM_NOTIFY_DISH_READY=False
# Bildirishnoma navbati: fon ishchi `python manage.py run_workers` yuboradi. Celery turtkisi shart emas.
OUTBOX_USE_CELERY=False

# ─── Lokal 3D menyu (taom rasmidan 3D) ─────────────────────────────────
# Mehmon menyusi ko'rsatadigan restoran slug'i (admin paneldagi "restaurant_default_shop" sozlamasi ustun)
RESTAURANT_DEFAULT_SHOP=
# Bosma QR kodlardagi domen (masalan https://menu.example.uz). Bo'sh bo'lsa — xodim ochgan sayt domeni.
RESTAURANT_PUBLIC_URL=
# Stolni oddiy raqam (?table=5, qo'lda kiritish) bilan tanlash: taxmin qilinadi, begona stolga buyurtma berish mumkin.
# Standart: faqat DEMO_MODE'da. Production'da QR token (/t/<uuid>/) ishlatiladi — shuni False qoldiring.
RESTAURANT_ALLOW_TABLE_NUMBER_URL=False
# 3D provayder: relief (AI'siz, lokal, bepul)
RESTAURANT_3D_PROVIDER=relief
RESTAURANT_3D_AUTO_GENERATE=True
# Eski xatti-harakat: nom bo'yicha kutubxona modeli / umumiy zaxira model (mijozni chalg'itishi mumkin)
RESTAURANT_3D_LIBRARY_AUTO=False
RESTAURANT_3D_GENERIC_FALLBACK=False

# ─── Mahsulot portlari va marshrutlash (laptop_server_daemon.py / ProductRoutingMiddleware) ──
PORT_RESTAURANT=8001
PORT_MARKET=8002
PORT_STUDIO=8003
# Qaysi mahsulot urlconf'i ishlashi: restaurant | market | studio (bo'sh — umumiy)
DJANGO_PRODUCT=
# Ulanishni qayta ishlatish (soniya); PostgreSQL'da 60 tavsiya etiladi
DB_CONN_MAX_AGE=0

# ─── Mahsulot botlari (bo'sh bo'lsa TELEGRAM_BOT_TOKEN ishlatiladi) ─────────────────
TELEGRAM_RESTAURANT_BOT_TOKEN=
TELEGRAM_MARKET_BOT_TOKEN=
TELEGRAM_STUDIO_BOT_TOKEN=

# ─── AI qo'shimcha modellar ───────────────────────────────────────────────────────────
AI_IMAGE_MODEL=dall-e-3
AI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Eski (legacy) admin paroli — ishlatilmasligi tavsiya etiladi; xodimlar login/parol bilan kiradi ──
ADMIN_PANEL_PASSWORD=
