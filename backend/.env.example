# ─── Core ───────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.uz
DJANGO_SETTINGS_MODULE=backend.settings

# ─── Database (PostgreSQL) — leave POSTGRES_DB empty to use SQLite ────────
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Redis / Celery ──────────────────────────────────────────────────────
# Leave REDIS_URL empty to run tasks eagerly (inline) without a broker.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─── Telegram Bot ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=

# ─── Payments ───────────────────────────────────────────────────────────
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_API_URL=https://api.click.uz/v1

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_API_URL=https://payme.uz/api/

UZCARD_MERCHANT_ID=
UZCARD_SECRET_KEY=
UZCARD_API_URL=https://api.paycom.uz/v2
UZCARD_CALLBACK_URL=

# ─── AI (OpenAI) ────────────────────────────────────────────────────────
AI_API_KEY=
AI_PROVIDER=openai
AI_TEXT_MODEL_FAST=gpt-4o-mini
AI_TEXT_MODEL_QUALITY=gpt-4o

# ─── Storage (S3-compatible) ────────────────────────────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ─── Monitoring ─────────────────────────────────────────────────────────
SENTRY_DSN=
TELEGRAM_ADMIN_CHAT_IDS=  # admin chat id lar (vergul bilan, ixtiyoriy)

# ─── V12: MCP — 8 ta AI provayder kalitlari (kalit qo'yilgach tizim o'zi aniqlaydi) ───
# python manage.py mcp_check   → hammasini bir daqiqada tekshiradi
# python manage.py mcp_status  → jadval: kalit/circuit/xarajat
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
MESHY_API_KEY=
TRIPO_API_KEY=
MCP_DAILY_BUDGET=5

# ─── Restoran Bosqich 0 (xavfsizlik) ─────────────────────────────────
# Demo rejim: mock to'lov, demo bron/taomlar. Production'da DOIM False.
DEMO_MODE=False
# Faqat mock to'lov sahifalarini yoqish (DEMO_MODE'siz). Production'da False.
ALLOW_MOCK_PAYMENTS=False
# Restoran xizmat haqi foizi (TZ qarori: olinmaydi → 0)
RESTAURANT_SERVICE_FEE_PERCENT=0
# Telegram webhook secret (ixtiyoriy). Bo'sh bo'lsa bot tokeni + SECRET_KEY dan avtomatik hosil qilinadi.
# O'zgartirilgandan keyin: python manage.py set_telegram_webhook <https://domen>
TELEGRAM_WEBHOOK_SECRET=

# ─── Lokal 3D menyu (taom rasmidan 3D) ─────────────────────────────────
# Mehmon menyusi ko'rsatadigan restoran slug'i (admin paneldagi "restaurant_default_shop" sozlamasi ustun)
RESTAURANT_DEFAULT_SHOP=
# 3D provayder: relief (AI'siz, lokal, bepul)
RESTAURANT_3D_PROVIDER=relief
RESTAURANT_3D_AUTO_GENERATE=True
# Eski xatti-harakat: nom bo'yicha kutubxona modeli / umumiy zaxira model (mijozni chalg'itishi mumkin)
RESTAURANT_3D_LIBRARY_AUTO=False
RESTAURANT_3D_GENERIC_FALLBACK=False
