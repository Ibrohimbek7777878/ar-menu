{
  "name": "seller-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Klassik Seller/Admin paneli uchun lokal aktivlar manbasi (Tailwind CSS, Alpine.js, shriftlar, Material Icons). Natija backend/static/ ichiga commit qilinadi.",
  "scripts": {
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "node scripts/build-css.mjs",
    "build:vendor": "node scripts/copy-vendor.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "alpinejs": "3.17.5",
    "autoprefixer": "10.4.21",
    "cssnano": "7.1.0",
    "material-icons": "1.13.14",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17"
  },
  "browserslist": [
    "defaults",
    "ios_saf >= 12",
    "safari >= 12",
    "chrome >= 80",
    "firefox >= 78"
  ]
}
