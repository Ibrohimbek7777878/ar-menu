[Unit]
Description=ARMENU Web (Daphne ASGI)
Requires=armenu.socket
After=network.target postgresql.service redis.service armenu.socket

[Service]
Type=simple
User=armenu
Group=armenu
WorkingDirectory=/opt/armenu
ExecStart=/opt/armenu/venv/bin/daphne -b 0.0.0.0 -p 8060 config.asgi:application
Restart=always
RestartSec=5
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod

[Install]
WantedBy=multi-user.target
